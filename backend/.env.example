PORT=3000

# Required for POST /api/cv/tailor and POST /api/cv/import (LLM-based CV
# tailoring and PDF-to-profile import). Without this set, both endpoints
# respond with 503.
ANTHROPIC_API_KEY=

# Required for POST /api/applications/send (emailing an application with
# the CV attached). Without these set, the endpoint responds with 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
